{
  "showMemoryUsage": true,
  "showLineNumbers": true,
  "allowMCPServers": ["gopls"],
  "excludeMCPServers": [],
  "mcpServers": {
    "gopls": {
      "command": "gopls",
      "args": ["mcp"],
      "timeout": 30000,
      "trust": true
    }
  },
  "tools": {
    "useRipgrep": true
  },
  "telemetry": {
    "enabled": true,
    "target": "gcp",
    "logPrompts": true,
    "outfile": "telemetry.log"
  },
  "privacy": {
    "usageStatisticsEnabled": true
  }
}
